# --- Database (Supabase: use the *Transaction pooler* URL, port 6543) ---
DATABASE_URL="postgresql://medstore:medstore@localhost:5432/medstore"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# Your storefront URL(s). Comma separated. Used for CORS + payment return links.
FRONTEND_URL="http://localhost:3000"

# --- Super admin (created/updated every time you run the seed) ---
SUPER_ADMIN_EMAIL="admin@medstore.local"
SUPER_ADMIN_PASSWORD="ChangeMe123!"

# --- Product picture uploads (Supabase Storage). Create a PUBLIC bucket named "product-images" ---
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="product-images"

# --- Optional: card payments through Stripe (not available for Pakistani merchants) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- MediCore link (see README) ---
# Pull: MediCore calls GET /api/integration/analytics with header x-api-key: <INTEGRATION_API_KEY>
INTEGRATION_API_KEY=""
# Push (optional): every new order / status change is POSTed here, signed with HMAC-SHA256
MEDICORE_WEBHOOK_URL=""
MEDICORE_WEBHOOK_SECRET=""
