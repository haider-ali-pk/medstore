generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  BRAND_ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  CARD
  WALLET // JazzCash / Easypaisa / bank transfer (customer pays, enters reference, admin confirms)
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
}

// One row per brand/client you sell the storefront to.
model Brand {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  domain              String?  @unique // e.g. shop.acmepharma.com
  tagline             String?
  logoUrl             String?
  primaryColor        String   @default("#0f766e")
  accentColor         String   @default("#0ea5e9")
  currency            String   @default("PKR")
  phone               String?
  whatsapp            String?
  email               String?
    address             String?
  licenseNo           String?  // pharmacy / DRAP licence number, shown in the website footer
  openingHours        String?  // e.g. "Mon–Sat 9am–11pm"
  deliveryFee         Decimal  @default(250) @db.Decimal(10, 2)
  freeDeliveryOver    Decimal? @default(5000) @db.Decimal(10, 2)
  codEnabled          Boolean  @default(true)
  cardEnabled         Boolean  @default(false)
  walletEnabled       Boolean  @default(false)
  paymentInstructions String?  // e.g. "JazzCash 0300-1234567 (CareWell Pharmacy)"
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  users      User[]
  categories Category[]
  products   Product[]
  orders     Order[]
}

model User {
  id           String   @id @default(cuid())
  email        String
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(CUSTOMER)
  brandId      String?
  brand        Brand?   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  orders       Order[]

  // Same email may register on different brands.
  @@unique([email, brandId])
  @@index([email])
}

model Category {
  id       String    @id @default(cuid())
  brandId  String
  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name     String
  slug     String
  products Product[]

  @@unique([brandId, slug])
}

model Product {
  id          String      @id @default(cuid())
  brandId     String
  brand       Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  slug        String
  description String      @default("")
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?
  stock       Int         @default(0)
    requiresRx  Boolean     @default(false)
  sku          String?
  genericName  String?
  manufacturer String?
  comparePrice Decimal?    @db.Decimal(10, 2) // MRP / old price, shown struck-through when higher than price
  externalId   String?     // id of the same item in MediCore's pharmacy inventory (used by /integration/products/sync)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  items       OrderItem[]

  @@unique([brandId, slug])
  @@index([brandId, isActive, createdAt])
  @@index([categoryId])
}

model Order {
  id              String        @id @default(cuid())
  orderNo         Int           @unique @default(autoincrement()) // readable number: MS-000123
  brandId         String
  brand           Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentRef      String?
  subtotal        Decimal       @default(0) @db.Decimal(10, 2)
  deliveryFee     Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  shipName        String
  shipPhone       String
  shipAddress     String
  shipCity        String
    notes           String?
  prescriptionPath String?      // private Supabase file (only when the order contains Rx medicines)
  stripeSessionId String?
  createdAt       DateTime      @default(now())
  items           OrderItem[]

  @@index([brandId, createdAt])
  @@index([userId, brandId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int

  @@index([orderId])
  @@index([productId])
}
